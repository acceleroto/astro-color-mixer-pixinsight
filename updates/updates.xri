<?xml version="1.0" encoding="UTF-8"?>

<xri version="1.0">

  <description>
    <p>Cosgrove's Cosmos PixInsight script repository</p>
  </description>

  <platform os="all" arch="noarch" version="1.8.0:1.9.9">

    <package
      fileName="AstroColorMixer-0.9.4-beta.zip"
      sha1="fb4335da97c1148f8c8e9143257ccf0b839ff30b"
      type="script"
      releaseDate="20260510"
      remove="src/scripts/CosgrovesCosmos/AstroColorMixer.js">

      <title>Astro Color Mixer v0.9.4-beta</title>

      <description>
        <p>Astro Color Mixer is a PixInsight script for nonlinear RGB color and luminance refinement in astrophotography.</p>
        <p>This beta includes H/S/L color-band controls, Neutral / Low-Saturation luminance, Stars Present and Starless / Star-Reduced modes, Selected Band width/feather, Range Mask, Refinement Passes, preview, mask views, histogram, polar plot, probe, pass viewer, Adjustment Set save/load, and Apply to New Image.</p>
        <p>This is a beta release for testing.</p>
      </description>

    </package>

  </platform>

</xri>
